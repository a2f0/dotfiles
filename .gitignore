.gitignore
.vagrant/
/aliases-private
/aws.config
/aws.credentials
/functions-private
/hosts
/id_rsa
/iptables.rules
/mcabberrc
/my.cnf
/offlineimaprc
/passwd-s3fs
/pgpass
/resolv.conf
/salt-roster
/ssh_config
/yp.conf
fstab-private
functions-private
iptables.rules-private
ssh_config
syslog-ng.conf-private
.DS_Store

# matrix-secrets link; no trailing slash, so the pattern matches the symlink
.secrets

# terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Plaintext left over from removed Blackbox files: *.tfvars above covers
# terraform/main.tfvars, and this entry the encrypted backend file's.
/terraform/terraform.backend

# ansible
.ansible/

# codex
/files/.codex/config.toml

# build artifacts
a.out

# Bun
node_modules/

# Python development environment
.venv/
__pycache__/

# Saved JSON infrastructure plans can contain secrets
*.tfplan.json
