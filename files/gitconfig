[commit]
        gpgsign = true
[pull]
        rebase = true
[filter "lfs"]
        smudge = git-lfs smudge -- %f
        process = git-lfs filter-process
        required = true
        clean = git-lfs clean -- %f
[pager]
        branch = false
[push]
        default = current
[core]
        pager = cat
        # Reach GitHub over SSH on port 443 (~/.config/git/ssh_config); plain
        # ssh until that file is provisioned.
        sshCommand = "sh -c 'f=\"$HOME/.config/git/ssh_config\"; if [ -r \"$f\" ]; then exec ssh -F \"$f\" \"$@\"; fi; exec ssh \"$@\"' git-ssh"
[ssh]
        # The wrapper runs OpenSSH; skip Git's `-G` probe for the SSH variant.
        variant = ssh
[url "git@github.com:"]
        # GitHub is SSH only: HTTPS URLs, for fetch and push, go over SSH.
        insteadOf = https://github.com/
[credential "https://github.com"]
        # An empty helper clears the osxkeychain helper that Xcode's system
        # gitconfig sets, so nothing that still reaches GitHub over HTTPS
        # waits on a keychain prompt.
        helper =
[branch]
        autosetupmerge = always
[init]
        defaultBranch = main
[alias]
	uncommit = reset --soft HEAD~1
        branches = branch -a --sort=-committerdate
        stashall = stash --include-untracked
        unstash = stash pop
[rerere]
	enabled = false
