{
  "schemaVersion": 1,
  "subject": {
    "maxLength": 50
  },
  "merge": {
    "requiredChecks": [
      {
        "name": "code-quality",
        "workflow": "Github Actions"
      },
      {
        "name": "ansible-ubuntu",
        "workflow": "Github Actions"
      }
    ]
  },
  "versions": {
    "packages": []
  },
  "pr": {
    "rejectClaudeBranding": true
  },
  "branch": {
    "types": [
      "feat",
      "fix",
      "docs",
      "style",
      "refactor",
      "perf",
      "test",
      "build",
      "ci",
      "chore",
      "revert"
    ],
    "exempt": [
      "main"
    ],
    "maxLength": null
  }
}
