{
  "name": "dotfiles",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "agent-tool": "agent-tool",
    "agent:run": "agent-tool run",
    "agent:logs": "agent-tool logs",
    "agents:check": "agent-tool skills check && agent-tool permissions check",
    "agents:sync": "agent-tool skills install --apply && agent-tool permissions install --apply",
    "test:markdownlint": "node --test tests/markdownlint.test.mjs",
    "lint:branch-name": "agent-tool branch check",
    "check": "agent-tool run-group scripts/testing/verify.json"
  },
  "devDependencies": {
    "@a2f0/agent-tool": "0.1.30",
    "jsonc-parser": "3.3.1",
    "markdownlint-cli2": "0.24.0"
  },
  "patchedDependencies": {
    "markdownlint@0.42.0": "patches/markdownlint@0.42.0.patch"
  }
}
